{
  "name": "car-dealership-api",
  "version": "1.0.0",
  "description": "Car Dealership API with TypeScript",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "NODE_ENV=production node dist/app.js",
    "dev": "NODE_ENV=development tsx watch src/app.ts",
    "test": "NODE_ENV=test vitest",
    "test:watch": "NODE_ENV=test vitest --watch",
    "test:integration": "NODE_ENV=test vitest run tests/integration",
    "test:coverage": "NODE_ENV=test vitest run --coverage",
    "migrate:dev": "NODE_ENV=development prisma migrate dev",
    "migrate:deploy": "NODE_ENV=production prisma migrate deploy",
    "migrate:test": "NODE_ENV=test prisma migrate deploy",
    "studio": "NODE_ENV=development prisma studio",
    "clean": "rm -rf dist",
    "seed": "NODE_ENV=development tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/client": "^7.6.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.0",
    "ejs": "^5.0.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "prism": "^4.1.2",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "vitest-environment-prisma-postgres": "^2.0.0"
  }
}
